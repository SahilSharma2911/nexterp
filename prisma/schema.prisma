// nexterp — a generic ERP, data model ported from ERPNext (frappe/erpnext)
// into Next.js + Prisma + Postgres. Names mirror ERPNext DocTypes.
// See docs/stock-ledger.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================== Auth ==============================
 */

// A login account. One simple role per user drives access.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN // everything, plus user management
  STOCK // stock + manufacturing
  BUYING // purchasing
  SELLING // sales
  ACCOUNTS // invoices, payments, ledgers
  VIEWER // read-only everywhere
}

/**
 * ============================== Masters ==============================
 */

// ERPNext: Item
model Item {
  id            String  @id @default(uuid()) @db.Uuid
  itemCode      String  @unique
  itemName      String
  description   String?
  itemGroup     String?
  stockUom      String  @default("Nos")
  brand         String?
  barcode       String?
  taxCode       String? // HSN / tax classification code
  isStockItem   Boolean @default(true)
  hasSerialNo   Boolean @default(false)
  hasBatchNo    Boolean @default(false)
  // Default/standard valuation (cost) rate used when no prior stock exists.
  valuationRate Decimal @default(0) @db.Decimal(18, 6)
  // Standard selling price.
  salesRate     Decimal @default(0) @db.Decimal(18, 6)
  // Reorder when projected stock falls below this (0 = no reorder).
  reorderLevel  Float   @default(0)
  imageUrl      String? // product image
  disabled      Boolean @default(false)

  // Variants (ERPNext: Item Variants). A template item defines variant
  // attributes; concrete variants point back via variantOfId.
  hasVariants Boolean @default(false)
  variantOfId String? @db.Uuid
  variantOf   Item?   @relation("ItemVariants", fields: [variantOfId], references: [id])
  variants    Item[]  @relation("ItemVariants")

  specifications    ItemSpecification[]
  variantAttributes ItemVariantAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches         Batch[]
  serials         SerialNo[]
  ledgerEntries   StockLedgerEntry[]
  bins            Bin[]
  stockEntryItems StockEntryDetail[]
  boms            Bom[]                     @relation("BomFinished")
  bomComponents   BomItem[]                 @relation("BomComponent")
  bomExplosions   BomExplosionItem[]        @relation("BomExploded")
  workOrders      WorkOrder[]               @relation("WoProduction")
  workOrderItems  WorkOrderItem[]           @relation("WoItem")
  reconItems      StockReconciliationItem[] @relation("SRItem")
  prItems         PurchaseReceiptItem[]     @relation("PRItem")
  dnItems         DeliveryNoteItem[]        @relation("DNItem")
  poItems         PurchaseOrderItem[]       @relation("POItem")
  soItems         SalesOrderItem[]          @relation("SOItem")
  siItems         SalesInvoiceItem[]        @relation("SIItem")
  piItems         PurchaseInvoiceItem[]     @relation("PIItem")

  @@index([itemGroup])
  @@index([disabled])
  @@index([variantOfId])
}

// Stock · batch/lot tracking. A Batch is a GROUP of identical units of an item
// that were produced/received together — sharing one lot number, one expiry
// and one scannable barcode. Enabled per item via Item.hasBatchNo. (Serialised
// items — Item.hasSerialNo — instead get one identity per individual unit.)
model Batch {
  id          String    @id @default(uuid()) @db.Uuid
  batchNo     String // lot number, e.g. B-2026-07
  itemId      String    @db.Uuid
  warehouseId String?   @db.Uuid // warehouse the lot was received into
  barcode     String? // scannable code for the whole lot
  mfgDate     DateTime?
  expiryDate  DateTime? // shelf-life cutoff (the point of batch tracking)
  qty         Float     @default(0) // opening quantity received into this batch
  supplier    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item          Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  ledgerEntries StockLedgerEntry[]

  @@unique([itemId, batchNo])
  @@index([itemId])
  @@index([expiryDate])
}

enum SerialStatus {
  IN_STOCK
  DELIVERED
  SCRAPPED
}

// Stock · serial-number tracking. One record per individual unit of a
// serialised item (Item.hasSerialNo) — each with its own identity + barcode,
// tracked through a simple in-stock → delivered / scrapped lifecycle.
model SerialNo {
  id          String       @id @default(uuid()) @db.Uuid
  serialNo    String
  itemId      String       @db.Uuid
  warehouseId String?      @db.Uuid
  barcode     String?
  status      SerialStatus @default(IN_STOCK)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, serialNo])
  @@index([itemId])
  @@index([status])
}

// Generic key/value spec for an item (e.g. Material: Steel, Weight: 2 kg).
model ItemSpecification {
  id        String @id @default(uuid()) @db.Uuid
  itemId    String @db.Uuid
  label     String
  value     String
  sortOrder Int    @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// A variant attribute defined on a template item (e.g. Size -> S,M,L).
// `values` is a comma-separated list of allowed values.
model ItemVariantAttribute {
  id        String @id @default(uuid()) @db.Uuid
  itemId    String @db.Uuid
  attribute String
  values    String
  sortOrder Int    @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// ERPNext: Warehouse
model Warehouse {
  id            String   @id @default(uuid()) @db.Uuid
  warehouseName String   @unique
  warehouseType String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  phone         String?
  email         String?
  contactPerson String?
  isGroup       Boolean  @default(false)
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())

  ledgerEntries    StockLedgerEntry[]
  batches          Batch[]
  serials          SerialNo[]
  bins             Bin[]
  stockEntriesFrom StockEntry[]              @relation("SEFrom")
  stockEntriesTo   StockEntry[]              @relation("SETo")
  sedFrom          StockEntryDetail[]        @relation("SEDFrom")
  sedTo            StockEntryDetail[]        @relation("SEDTo")
  woSource         WorkOrder[]               @relation("WoSource")
  woFg             WorkOrder[]               @relation("WoFg")
  reconItems       StockReconciliationItem[] @relation("SRWh")
  purchaseReceipts PurchaseReceipt[]         @relation("PRWh")
  deliveryNotes    DeliveryNote[]            @relation("DNWh")
  purchaseOrders   PurchaseOrder[]           @relation("POWh")
  salesOrders      SalesOrder[]              @relation("SOWh")

  @@index([disabled])
}

/**
 * ============================== Stock ledger ==============================
 */

enum StockEntryPurpose {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  MANUFACTURE
  REPACK
}

enum DocStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

// ERPNext: Stock Ledger Entry — immutable, append-only.
model StockLedgerEntry {
  id                   String   @id @default(uuid()) @db.Uuid
  itemId               String   @db.Uuid
  warehouseId          String   @db.Uuid
  postingAt            DateTime
  voucherType          String
  voucherNo            String
  voucherDetailId      String?  @db.Uuid
  actualQty            Float
  qtyAfterTransaction  Float
  incomingRate         Decimal  @default(0) @db.Decimal(18, 6)
  valuationRate        Decimal  @default(0) @db.Decimal(18, 6)
  stockValue           Decimal  @default(0) @db.Decimal(18, 2)
  stockValueDifference Decimal  @default(0) @db.Decimal(18, 2)
  batchNo              String?
  batchId              String?  @db.Uuid // batch/lot this movement is attributed to
  serialNos            String?
  isCancelled          Boolean  @default(false)
  createdAt            DateTime @default(now())
  createdBy            String?

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  batch     Batch?    @relation(fields: [batchId], references: [id])

  @@index([itemId, warehouseId, postingAt])
  @@index([voucherType, voucherNo])
  @@index([isCancelled])
  @@index([batchId])
}

// ERPNext: Bin — cached running balance per (item, warehouse).
model Bin {
  id            String   @id @default(uuid()) @db.Uuid
  itemId        String   @db.Uuid
  warehouseId   String   @db.Uuid
  actualQty     Float    @default(0)
  reservedQty   Float    @default(0)
  orderedQty    Float    @default(0)
  plannedQty    Float    @default(0)
  projectedQty  Float    @default(0)
  valuationRate Decimal  @default(0) @db.Decimal(18, 6)
  stockValue    Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt     DateTime @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
}

// ERPNext: Stock Entry (the voucher) — receipt / issue / transfer / manufacture.
model StockEntry {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String            @unique
  purpose            StockEntryPurpose
  status             DocStatus         @default(DRAFT)
  postingAt          DateTime          @default(now())
  fromWarehouseId    String?           @db.Uuid
  toWarehouseId      String?           @db.Uuid
  totalIncomingValue Decimal           @default(0) @db.Decimal(18, 2)
  totalOutgoingValue Decimal           @default(0) @db.Decimal(18, 2)
  valueDifference    Decimal           @default(0) @db.Decimal(18, 2)
  remarks            String?
  workOrderId        String?           @db.Uuid
  submittedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?

  fromWarehouse Warehouse?         @relation("SEFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?         @relation("SETo", fields: [toWarehouseId], references: [id])
  workOrder     WorkOrder?         @relation(fields: [workOrderId], references: [id])
  items         StockEntryDetail[]

  @@index([status])
  @@index([purpose])
}

/**
 * ============================== Manufacturing ==============================
 */

enum WorkOrderStatus {
  NOT_STARTED
  IN_PROCESS
  COMPLETED
  CANCELLED
}

// ERPNext: Bom — a submittable recipe for a finished item.
model Bom {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  itemId      String    @db.Uuid
  quantity    Float     @default(1)
  uom         String    @default("Nos")
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  status      DocStatus @default(DRAFT)
  totalCost   Decimal   @default(0) @db.Decimal(18, 2)
  remarks     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item           Item               @relation("BomFinished", fields: [itemId], references: [id])
  items          BomItem[]
  explosionItems BomExplosionItem[]
  workOrders     WorkOrder[]

  @@index([itemId])
  @@index([status])
}

model BomItem {
  id     String  @id @default(uuid()) @db.Uuid
  bomId  String  @db.Uuid
  itemId String  @db.Uuid
  qty    Float
  uom    String  @default("Nos")
  rate   Decimal @default(0) @db.Decimal(18, 6)
  amount Decimal @default(0) @db.Decimal(18, 2)

  bom  Bom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation("BomComponent", fields: [itemId], references: [id])

  @@index([bomId])
  @@index([itemId])
}

// Fully-exploded raw materials (multi-level), computed on Bom submit.
model BomExplosionItem {
  id     String  @id @default(uuid()) @db.Uuid
  bomId  String  @db.Uuid
  itemId String  @db.Uuid
  qty    Float
  rate   Decimal @default(0) @db.Decimal(18, 6)
  amount Decimal @default(0) @db.Decimal(18, 2)

  bom  Bom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation("BomExploded", fields: [itemId], references: [id])

  @@index([bomId])
}

// ERPNext: Work Order — produce N of an item from a Bom.
model WorkOrder {
  id                String          @id @default(uuid()) @db.Uuid
  name              String          @unique
  productionItemId  String          @db.Uuid
  bomId             String          @db.Uuid
  qty               Float
  producedQty       Float           @default(0)
  useMultiLevelBom  Boolean         @default(true)
  status            WorkOrderStatus @default(NOT_STARTED)
  sourceWarehouseId String?         @db.Uuid
  fgWarehouseId     String?         @db.Uuid
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productionItem  Item            @relation("WoProduction", fields: [productionItemId], references: [id])
  bom             Bom             @relation(fields: [bomId], references: [id])
  sourceWarehouse Warehouse?      @relation("WoSource", fields: [sourceWarehouseId], references: [id])
  fgWarehouse     Warehouse?      @relation("WoFg", fields: [fgWarehouseId], references: [id])
  items           WorkOrderItem[]
  stockEntries    StockEntry[]

  @@index([status])
  @@index([bomId])
}

model WorkOrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  workOrderId String  @db.Uuid
  itemId      String  @db.Uuid
  requiredQty Float
  consumedQty Float   @default(0)
  rate        Decimal @default(0) @db.Decimal(18, 6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  item      Item      @relation("WoItem", fields: [itemId], references: [id])

  @@index([workOrderId])
}

// ERPNext: Stock Reconciliation — set absolute on-hand qty/valuation (physical
// count or opening stock). Submittable.
model StockReconciliation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  status      DocStatus @default(DRAFT)
  postingAt   DateTime  @default(now())
  remarks     String?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?

  items StockReconciliationItem[]

  @@index([status])
}

model StockReconciliationItem {
  id               String  @id @default(uuid()) @db.Uuid
  reconciliationId String  @db.Uuid
  itemId           String  @db.Uuid
  warehouseId      String  @db.Uuid
  qty              Float // counted / target qty
  valuationRate    Decimal @default(0) @db.Decimal(18, 6)
  currentQty       Float   @default(0) // snapshot before submit (for cancel)
  currentRate      Decimal @default(0) @db.Decimal(18, 6)

  reconciliation StockReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  item           Item                @relation("SRItem", fields: [itemId], references: [id])
  warehouse      Warehouse           @relation("SRWh", fields: [warehouseId], references: [id])

  @@index([reconciliationId])
}

// ERPNext: Stock Entry Detail
model StockEntryDetail {
  id             String  @id @default(uuid()) @db.Uuid
  stockEntryId   String  @db.Uuid
  itemId         String  @db.Uuid
  sWarehouseId   String? @db.Uuid
  tWarehouseId   String? @db.Uuid
  qty            Float
  uom            String  @default("Nos")
  basicRate      Decimal @default(0) @db.Decimal(18, 6)
  valuationRate  Decimal @default(0) @db.Decimal(18, 6)
  amount         Decimal @default(0) @db.Decimal(18, 2)
  isFinishedItem Boolean @default(false)
  note           String?

  stockEntry StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])
  sWarehouse Warehouse? @relation("SEDFrom", fields: [sWarehouseId], references: [id])
  tWarehouse Warehouse? @relation("SEDTo", fields: [tWarehouseId], references: [id])

  @@index([stockEntryId])
  @@index([itemId])
}

/**
 * ============================== Parties ==============================
 */

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  customerName  String   @unique
  customerGroup String?
  territory     String?
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())

  deliveryNotes  DeliveryNote[]
  salesOrders    SalesOrder[]
  salesInvoices  SalesInvoice[]
  paymentEntries PaymentEntry[]

  @@index([disabled])
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  supplierName  String   @unique
  supplierGroup String?
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())

  purchaseReceipts PurchaseReceipt[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  paymentEntries   PaymentEntry[]

  @@index([disabled])
}

/**
 * ============================== Buying ==============================
 */

// ERPNext: Purchase Receipt — receives goods into a warehouse (stock in).
model PurchaseReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @unique
  supplierId      String    @db.Uuid
  warehouseId     String    @db.Uuid
  status          DocStatus @default(DRAFT)
  postingAt       DateTime  @default(now())
  totalQty        Float     @default(0)
  totalAmount     Decimal   @default(0) @db.Decimal(18, 2)
  remarks         String?
  purchaseOrderId String?   @db.Uuid
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?

  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse             @relation("PRWh", fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  items         PurchaseReceiptItem[]

  @@index([status])
}

model PurchaseReceiptItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseReceiptId String  @db.Uuid
  itemId            String  @db.Uuid
  qty               Float
  uom               String  @default("Nos")
  rate              Decimal @default(0) @db.Decimal(18, 6)
  amount            Decimal @default(0) @db.Decimal(18, 2)

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  item            Item            @relation("PRItem", fields: [itemId], references: [id])

  @@index([purchaseReceiptId])
}

/**
 * ============================== Selling ==============================
 */

// ERPNext: Delivery Note — ships goods out of a warehouse (stock out).
model DeliveryNote {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  customerId   String    @db.Uuid
  warehouseId  String    @db.Uuid
  status       DocStatus @default(DRAFT)
  postingAt    DateTime  @default(now())
  totalQty     Float     @default(0)
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2) // selling value
  totalCogs    Decimal   @default(0) @db.Decimal(18, 2) // cost of goods delivered
  remarks      String?
  salesOrderId String?   @db.Uuid
  submittedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  customer   Customer           @relation(fields: [customerId], references: [id])
  warehouse  Warehouse          @relation("DNWh", fields: [warehouseId], references: [id])
  salesOrder SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  items      DeliveryNoteItem[]

  @@index([status])
}

model DeliveryNoteItem {
  id             String  @id @default(uuid()) @db.Uuid
  deliveryNoteId String  @db.Uuid
  itemId         String  @db.Uuid
  qty            Float
  uom            String  @default("Nos")
  rate           Decimal @default(0) @db.Decimal(18, 6) // selling price
  amount         Decimal @default(0) @db.Decimal(18, 2) // selling value
  valuationRate  Decimal @default(0) @db.Decimal(18, 6) // COGS captured on submit

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item         Item         @relation("DNItem", fields: [itemId], references: [id])

  @@index([deliveryNoteId])
}

/**
 * ============================== Orders (planning) ==============================
 */

enum OrderStatus {
  DRAFT
  TO_FULFILL
  COMPLETED
  CANCELLED
}

// ERPNext: Purchase Order — order goods from a supplier (increments Bin.orderedQty).
model PurchaseOrder {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  supplierId  String      @db.Uuid
  warehouseId String      @db.Uuid
  status      OrderStatus @default(DRAFT)
  postingAt   DateTime    @default(now())
  requiredBy  DateTime?
  totalQty    Float       @default(0)
  totalAmount Decimal     @default(0) @db.Decimal(18, 2)
  remarks     String?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation("POWh", fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]
  receipts  PurchaseReceipt[]

  @@index([status])
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  itemId          String  @db.Uuid
  qty             Float
  rate            Decimal @default(0) @db.Decimal(18, 6)
  amount          Decimal @default(0) @db.Decimal(18, 2)
  receivedQty     Float   @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation("POItem", fields: [itemId], references: [id])

  @@index([purchaseOrderId])
}

// ERPNext: Sales Order — order from a customer (increments Bin.reservedQty).
model SalesOrder {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @unique
  customerId   String      @db.Uuid
  warehouseId  String      @db.Uuid
  status       OrderStatus @default(DRAFT)
  postingAt    DateTime    @default(now())
  deliveryDate DateTime?
  totalQty     Float       @default(0)
  totalAmount  Decimal     @default(0) @db.Decimal(18, 2)
  remarks      String?
  submittedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer   Customer         @relation(fields: [customerId], references: [id])
  warehouse  Warehouse        @relation("SOWh", fields: [warehouseId], references: [id])
  items      SalesOrderItem[]
  deliveries DeliveryNote[]

  @@index([status])
}

model SalesOrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  salesOrderId String  @db.Uuid
  itemId       String  @db.Uuid
  qty          Float
  rate         Decimal @default(0) @db.Decimal(18, 6)
  amount       Decimal @default(0) @db.Decimal(18, 2)
  deliveredQty Float   @default(0)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation("SOItem", fields: [itemId], references: [id])

  @@index([salesOrderId])
}

/**
 * ============================== Accounts ==============================
 */

enum RootType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum PaymentType {
  RECEIVE
  PAY
}

// ERPNext: Account (Chart of Accounts).
model Account {
  id          String   @id @default(uuid()) @db.Uuid
  accountName String   @unique
  accountType String? // Receivable, Payable, Cash, Bank, Income Account, Expense Account...
  rootType    RootType
  isGroup     Boolean  @default(false)
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now())

  glEntries      GLEntry[]
  paymentEntries PaymentEntry[]

  @@index([rootType])
}

// ERPNext: GL Entry — immutable, double-entry (debits = credits per voucher).
model GLEntry {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @db.Uuid
  postingAt    DateTime
  voucherType  String
  voucherNo    String
  debit        Decimal  @default(0) @db.Decimal(18, 2)
  credit       Decimal  @default(0) @db.Decimal(18, 2)
  againstParty String?
  remarks      String?
  isCancelled  Boolean  @default(false)
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([voucherType, voucherNo])
  @@index([isCancelled])
}

// ERPNext: Sales Invoice — bill a customer.
model SalesInvoice {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  customerId  String    @db.Uuid
  status      DocStatus @default(DRAFT)
  postingAt   DateTime  @default(now())
  dueDate     DateTime?
  total       Decimal   @default(0) @db.Decimal(18, 2)
  outstanding Decimal   @default(0) @db.Decimal(18, 2)
  remarks     String?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer       Customer           @relation(fields: [customerId], references: [id])
  items          SalesInvoiceItem[]
  paymentEntries PaymentEntry[]

  @@index([status])
}

model SalesInvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  salesInvoiceId String  @db.Uuid
  itemId         String  @db.Uuid
  qty            Float
  rate           Decimal @default(0) @db.Decimal(18, 6)
  amount         Decimal @default(0) @db.Decimal(18, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  item         Item         @relation("SIItem", fields: [itemId], references: [id])

  @@index([salesInvoiceId])
}

// ERPNext: Purchase Invoice — bill from a supplier.
model PurchaseInvoice {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  supplierId  String    @db.Uuid
  status      DocStatus @default(DRAFT)
  postingAt   DateTime  @default(now())
  dueDate     DateTime?
  total       Decimal   @default(0) @db.Decimal(18, 2)
  outstanding Decimal   @default(0) @db.Decimal(18, 2)
  remarks     String?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  items          PurchaseInvoiceItem[]
  paymentEntries PaymentEntry[]

  @@index([status])
}

model PurchaseInvoiceItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String  @db.Uuid
  itemId            String  @db.Uuid
  qty               Float
  rate              Decimal @default(0) @db.Decimal(18, 6)
  amount            Decimal @default(0) @db.Decimal(18, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item            @relation("PIItem", fields: [itemId], references: [id])

  @@index([purchaseInvoiceId])
}

// ERPNext: Payment Entry — receive from a customer or pay a supplier.
model PaymentEntry {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @unique
  paymentType       PaymentType
  accountId         String      @db.Uuid // Cash/Bank
  customerId        String?     @db.Uuid
  supplierId        String?     @db.Uuid
  salesInvoiceId    String?     @db.Uuid
  purchaseInvoiceId String?     @db.Uuid
  amount            Decimal     @default(0) @db.Decimal(18, 2)
  status            DocStatus   @default(DRAFT)
  postingAt         DateTime    @default(now())
  remarks           String?
  submittedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  account         Account          @relation(fields: [accountId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// DMS vertical (module: dms). EV-native vehicle unit. References the core
// Warehouse by id only (no back-relation) so the core stays unaware of this
// module — the boundary that lets verticals be added/removed independently.
// ─────────────────────────────────────────────────────────────────────────────
model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  vin           String        @unique // chassis / VIN
  model         String
  variant       String?
  color         String?
  motorSerial   String?
  batterySerial String?
  batterySoH    Float? // battery State of Health, %
  status        VehicleStatus @default(IN_STOCK)
  mfgDate       DateTime?
  purchaseRate  Decimal       @default(0) @db.Decimal(18, 2)
  sellingRate   Decimal       @default(0) @db.Decimal(18, 2)
  warehouseId   String?       @db.Uuid // loose ref to core Warehouse
  dealerId      String?       @db.Uuid // intra-module link to Dealer
  imageUrl      String? // vehicle photo
  customerId    String?       @db.Uuid // core Customer (loose ref), set at delivery
  customerName  String? // buyer name captured at delivery
  deliveredAt   DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dealer         Dealer?                @relation(fields: [dealerId], references: [id])
  jobCards       JobCard[]
  warranties     Warranty[]
  subsidyClaims  SubsidyClaim[]
  events         VehicleEvent[]
  inspections    VehicleInspection[]
  accessories    VehicleAccessory[]
  appointments   ServiceAppointment[]
  specifications VehicleSpecification[]

  @@index([status])
  @@index([dealerId])
}

// DMS vertical — an accessory/add-on (a core Item) sold with a vehicle at
// delivery. Issued from stock; its value is added to the sale.
model VehicleAccessory {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  itemId    String  @db.Uuid // loose ref to core Item
  qty       Float   @default(1)
  rate      Decimal @default(0) @db.Decimal(18, 6)
  amount    Decimal @default(0) @db.Decimal(18, 2)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// DMS vertical — free-form key/value spec for a vehicle (e.g. Tyre size,
// Warranty pack, Insurance). Mirrors the core ItemSpecification.
model VehicleSpecification {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @db.Uuid
  label     String
  value     String
  sortOrder Int    @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// Lifecycle stage of a vehicle unit. IN_STOCK = received at warehouse.
enum VehicleStatus {
  IN_STOCK
  ALLOCATED
  IN_TRANSIT
  AT_DEALER
  PDI_DONE
  DELIVERED
  IN_SERVICE
}

// DMS vertical — one movement/event in a vehicle's lifecycle (audit timeline).
model VehicleEvent {
  id          String        @id @default(uuid()) @db.Uuid
  vehicleId   String        @db.Uuid
  stage       VehicleStatus // stage this event set the vehicle to
  note        String?
  dealerId    String?       @db.Uuid
  warehouseId String?       @db.Uuid
  byUser      String? // who performed it (name/email from session)
  at          DateTime      @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// DMS vertical — Pre-Delivery Inspection, run before handover.
model VehicleInspection {
  id        String           @id @default(uuid()) @db.Uuid
  vehicleId String           @db.Uuid
  inspector String?
  result    InspectionResult @default(PASS)
  note      String?
  createdAt DateTime         @default(now())

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items   VehicleInspItem[]

  @@index([vehicleId])
}

model VehicleInspItem {
  id           String  @id @default(uuid()) @db.Uuid
  inspectionId String  @db.Uuid
  label        String
  ok           Boolean @default(true)
  note         String?

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

enum InspectionResult {
  PASS
  FAIL
}

// DMS vertical — dealership in the OEM network. A specialization of the generic
// "party" concept, kept inside the module (the core has no Dealer notion).
model Dealer {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique // network dealer code
  name          String
  logoUrl       String? // dealer logo
  legalName     String?
  contactPerson String?
  phone         String?
  email         String?
  gstin         String? // tax registration
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles           Vehicle[]
  allocationRequests AllocationRequest[]
}

// DMS · Allocation — a dealer's demand for vehicles, fulfilled by the FIFO
// allocation engine (oldest matching stock first).
model AllocationRequest {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique // ALLOC-2026-00001
  dealerId     String           @db.Uuid
  model        String
  variant      String?
  qty          Int
  qtyAllocated Int              @default(0)
  priority     Int              @default(2) // 1 high · 2 normal · 3 low
  status       AllocationStatus @default(PENDING)
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  dealer Dealer @relation(fields: [dealerId], references: [id])

  @@index([status])
  @@index([dealerId])
}

enum AllocationStatus {
  PENDING
  PARTIAL
  FULFILLED
  CANCELLED
}

// DMS · Allocation — the single, editable FIFO rule set the engine applies.
model AllocationRule {
  id           String   @id @default(uuid()) @db.Uuid
  oldestFirst  Boolean  @default(true) // FIFO: allocate oldest stock first
  matchModel   Boolean  @default(true) // only allocate a matching model
  matchVariant Boolean  @default(false) // also match the variant
  maxAgeDays   Int? // flag stock sitting longer than this
  singleton    Boolean  @unique @default(true) // enforce one row
  updatedAt    DateTime @updatedAt
}

// DMS vertical — workshop Job Card. Reuses the CORE engines on completion:
// parts are issued through the stock ledger (lib/stock-ledger) and revenue is
// posted to the GL (lib/gl). Parts reference core Item by id only (no relation)
// so the core stays unaware of this module.
model JobCard {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique // JOB-2026-00001
  vehicleId    String    @db.Uuid
  warehouseId  String?   @db.Uuid // core Warehouse parts are issued from
  status       JobStatus @default(OPEN)
  complaint    String?
  technician   String? // free-text name (legacy / walk-in); prefer technicianId
  technicianId String?   @db.Uuid // Service & Workshop — assigned Technician entity
  bayId        String?   @db.Uuid // Service & Workshop — assigned ServiceBay
  isHV         Boolean   @default(false) // high-voltage (battery/motor) work
  odometer     Int?
  serviceDate  DateTime  @default(now())
  partsTotal   Decimal   @default(0) @db.Decimal(18, 2)
  laborTotal   Decimal   @default(0) @db.Decimal(18, 2)
  total        Decimal   @default(0) @db.Decimal(18, 2)
  photos       String[]  @default([]) // workshop photo documentation
  remarks      String?
  qcBy         String? // Service & Workshop — quality check sign-off
  qcAt         DateTime?
  qcNote       String?
  approvedBy   String? // who approved the estimate (ESTIMATE → OPEN)
  approvedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle       Vehicle             @relation(fields: [vehicleId], references: [id])
  technicianRef Technician?         @relation(fields: [technicianId], references: [id])
  bay           ServiceBay?         @relation(fields: [bayId], references: [id])
  appointment   ServiceAppointment?
  parts         JobCardPart[]
  labor         JobCardLabor[]

  @@index([status])
  @@index([vehicleId])
}

model JobCardPart {
  id        String  @id @default(uuid()) @db.Uuid
  jobCardId String  @db.Uuid
  itemId    String  @db.Uuid // loose ref to core Item
  qty       Float
  rate      Decimal @default(0) @db.Decimal(18, 6)
  amount    Decimal @default(0) @db.Decimal(18, 2)

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model JobCardLabor {
  id          String  @id @default(uuid()) @db.Uuid
  jobCardId   String  @db.Uuid
  description String
  hours       Float   @default(0)
  rate        Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

enum JobStatus {
  ESTIMATE
  OPEN
  COMPLETED
  CANCELLED
}

// DMS · Service & Workshop — a workshop technician. HV-certified techs are the
// only ones allowed on high-voltage (battery/motor) work.
model Technician {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  skills        String? // free-text specialities
  phone         String?
  isHVCertified Boolean  @default(false) // cleared for high-voltage work
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments ServiceAppointment[]
  jobCards     JobCard[]

  @@index([active])
}

// DMS · Service & Workshop — a physical service bay. HV bays are required for
// high-voltage work.
model ServiceBay {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isHV      Boolean  @default(false) // equipped for high-voltage work
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments ServiceAppointment[]
  jobCards     JobCard[]

  @@index([active])
}

// DMS · Service & Workshop — a booking for a service visit. Assigns a bay +
// technician (enforcing the HV rule), then converts into a Job Card when work
// starts. References core Vehicle by relation inside the module.
model ServiceAppointment {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @unique // APPT-2026-00001
  vehicleId    String            @db.Uuid
  customerName String?
  requestedAt  DateTime
  isHV         Boolean           @default(false) // high-voltage work requested?
  bayId        String?           @db.Uuid
  technicianId String?           @db.Uuid
  complaint    String?
  status       AppointmentStatus @default(BOOKED)
  jobCardId    String?           @unique @db.Uuid // set once converted
  remarks      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id])
  bay        ServiceBay? @relation(fields: [bayId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])
  jobCard    JobCard?    @relation(fields: [jobCardId], references: [id])

  @@index([status])
  @@index([vehicleId])
}

enum AppointmentStatus {
  BOOKED
  CONVERTED
  CANCELLED
}

// DMS vertical — component-level warranty registration for a vehicle. Battery
// warranties carry an optional State-of-Health threshold used by claim
// eligibility checks.
model Warranty {
  id           String            @id @default(uuid()) @db.Uuid
  vehicleId    String            @db.Uuid
  component    WarrantyComponent
  startDate    DateTime
  months       Int // coverage period
  kmLimit      Int? // optional usage cap
  soHThreshold Float? // battery: covered if SoH drops below this %
  status       WarrantyStatus    @default(ACTIVE)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  vehicle Vehicle         @relation(fields: [vehicleId], references: [id])
  claims  WarrantyClaim[]

  @@index([vehicleId])
  @@index([component])
}

// DMS vertical — a claim raised against a warranty, tracked through the OEM
// reimbursement workflow. May be raised from a Job Card (loose ref).
model WarrantyClaim {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique // WCLM-2026-00001
  warrantyId      String      @db.Uuid
  jobCardId       String?     @db.Uuid // loose ref to the job that found it
  claimDate       DateTime    @default(now())
  description     String?
  status          ClaimStatus @default(DRAFT)
  claimAmount     Decimal     @default(0) @db.Decimal(18, 2)
  approvedAmount  Decimal     @default(0) @db.Decimal(18, 2)
  oemRef          String?
  eligible        Boolean? // verdict computed at submit
  eligibilityNote String?
  remarks         String?
  submittedAt     DateTime?
  settledAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  warranty Warranty @relation(fields: [warrantyId], references: [id])

  @@index([status])
  @@index([warrantyId])
}

enum WarrantyComponent {
  VEHICLE
  BATTERY
  MOTOR
  CONTROLLER
  CHARGER
}

enum WarrantyStatus {
  ACTIVE
  VOID
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SETTLED
  CANCELLED
}

// DMS vertical — a government/OEM EV incentive scheme (e.g. FAME-II, state EV
// policy) that pays a subsidy per qualifying vehicle.
model SubsidyScheme {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  authority String? // granting body
  amount    Decimal       @default(0) @db.Decimal(18, 2) // subsidy per vehicle
  validFrom DateTime?
  validTo   DateTime?
  status    SubsidyStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  claims SubsidyClaim[]

  @@index([status])
}

// DMS vertical — a subsidy claim for one vehicle sale. KYC must be verified
// before submission; an e-voucher is generated on approval; disbursement is
// tracked for reconciliation.
model SubsidyClaim {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique // SUB-2026-00001
  schemeId     String             @db.Uuid
  vehicleId    String             @db.Uuid
  customerName String
  kycDocType   String? // Aadhaar / PAN / Passport …
  kycRef       String? // document number
  kycDocUrl    String? // scan/photo of the KYC document
  kycVerified  Boolean            @default(false)
  claimAmount  Decimal            @default(0) @db.Decimal(18, 2)
  status       SubsidyClaimStatus @default(DRAFT)
  voucherNo    String? // e-voucher, generated on approval
  approvedAt   DateTime?
  disbursedAt  DateTime?
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  scheme  SubsidyScheme @relation(fields: [schemeId], references: [id])
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([schemeId])
  @@index([vehicleId])
}

enum SubsidyStatus {
  ACTIVE
  CLOSED
}

enum SubsidyClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISBURSED
  REJECTED
  CANCELLED
}
